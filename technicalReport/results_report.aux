\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces eNDI NRMSE (\%) at 25 fixed iterations. The cascade equals $B$ within $0.35$ on all forward-simulated fields, exp1 and exp3, lowers the measured residual (exp7) by $13$ points relative to $B$ and exp8/exp9 by $9$/$16$; the joint network is better on exp7--9 but costs $0.2$--$3.2$ points on noise-like data. Real Sim2: $B$ is $47.48$ here and $47.31$ in the trainer's own output (a different outside-the-mask convention).}}{7}{table.caption.14}\protected@file@percent }
\newlabel{tab:main}{{5}{7}{eNDI NRMSE (\%) at 25 fixed iterations. The cascade equals $B$ within $0.35$ on all forward-simulated fields, exp1 and exp3, lowers the measured residual (exp7) by $13$ points relative to $B$ and exp8/exp9 by $9$/$16$; the joint network is better on exp7--9 but costs $0.2$--$3.2$ points on noise-like data. Real Sim2: $B$ is $47.48$ here and $47.31$ in the trainer's own output (a different outside-the-mask convention)}{table.caption.14}{}}
\newlabel{tab:main@cref}{{[table][5][]5}{[1][6][]7}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Attempts to protect strong sources. Suppressor: the gate is multiplied by $1-\mathrm  {smoothstep}\big  ((\ell -\ell _0)/(\ell _1-\ell _0)\big  )$, $\ell $ the local rms of the field; thresholds read from RC1 only (real residuals and noise stay below $0.06$\,ppm at $\sigma =2.5$, exp5/exp6 reach $0.41/0.16$ at p99.9). (The exp8/exp9 entries of the first two rows are from the server table, history index 25.) None meets the exp5, exp6 or Sim2 criteria; the suppressor does nothing on Sim2 because the compact calcification does not reach the threshold after smoothing (thresholds were \emph  {not} retuned on Sim2).}}{7}{table.caption.18}\protected@file@percent }
\newlabel{tab:strong}{{6}{7}{Attempts to protect strong sources. Suppressor: the gate is multiplied by $1-\mathrm {smoothstep}\big ((\ell -\ell _0)/(\ell _1-\ell _0)\big )$, $\ell $ the local rms of the field; thresholds read from RC1 only (real residuals and noise stay below $0.06$\,ppm at $\sigma =2.5$, exp5/exp6 reach $0.41/0.16$ at p99.9). (The exp8/exp9 entries of the first two rows are from the server table, history index 25.) None meets the exp5, exp6 or Sim2 criteria; the suppressor does nothing on Sim2 because the compact calcification does not reach the threshold after smoothing (thresholds were \emph {not} retuned on Sim2)}{table.caption.18}{}}
\newlabel{tab:strong@cref}{{[table][6][]6}{[1][6][]7}{}{}{}}
